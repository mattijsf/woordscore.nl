{
  "name": "woordle-scorebord",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run check && vite",
    "build": "npm run check && vite build",
    "preview": "vite preview",
    "check": "node scripts/check.ts",
    "import": "node scripts/import-whatsapp.ts",
    "pull": "node scripts/pull.ts",
    "lint": "eslint --cache --max-warnings=0 .",
    "lint:fix": "eslint --cache --max-warnings=0 --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "knip": "knip",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run knip",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-filename-export": "^2.0.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "knip": "^6.48.0",
    "lefthook": "^2.2.4",
    "prettier": "^3.10.1",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.2"
  }
}
