// The page: runs in the browser, bundled by vite.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    // src/data.json is generated; src/data.d.json.ts says what it holds
    "allowArbitraryExtensions": true,
    "types": ["vite/client"]
  },
  "include": ["src"]
}
