// Everything that runs outside the browser: the scripts, the server and the vite config.
{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "resolveJsonModule": true
  },
  "include": ["scripts", "server", "vite.config.ts"]
}
